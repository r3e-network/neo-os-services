[Unit]
Description=NeoOS Rust Relayer (Neo N3 and NeoX request/feed authority)
After=network-online.target
Wants=network-online.target
Conflicts=morpheus-relayer-nitro.service morpheus-feed-pusher.service morpheus-feed-pusher.timer morpheus-feed-pusher-neox.service morpheus-feed-pusher-neox.timer morpheus-feed-pusher-testnet.service morpheus-feed-pusher-testnet.timer morpheus-feed-topup.service morpheus-feed-topup.timer morpheus-neox-fulfiller.service

[Service]
Type=simple
WorkingDirectory=/var/lib/neo-os-relayer
EnvironmentFile=/opt/morpheus/nitro/neo-os-relayer.env
Environment=NODE_ENV=production
StateDirectory=neo-os-relayer
ExecStartPre=/opt/neoos/services/bin/neo-os-relayer config:validate
ExecStart=/opt/neoos/services/bin/neo-os-relayer loop
Restart=always
RestartSec=5
TimeoutStopSec=120
User=morpheus
Group=morpheus
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
