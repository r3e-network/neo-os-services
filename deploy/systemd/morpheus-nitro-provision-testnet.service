[Unit]
Description=Morpheus TestNet Nitro Enclave compute provisioning
After=morpheus-nitro-signer-testnet.service morpheus-nitro-egress.service
PartOf=morpheus-nitro-signer-testnet.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=MORPHEUS_NITRO_HOST_PORT=8789
Environment=MORPHEUS_NITRO_SIGNER_ENV=/opt/morpheus/nitro/morpheus-nitro-signer-testnet.env
Environment=MORPHEUS_NITRO_FEED_ENV=/opt/morpheus/nitro/feed-pusher-testnet.env
Environment=MORPHEUS_NITRO_WORKER_ENV=/opt/morpheus/nitro/nitro-worker-testnet.env
ExecStart=/opt/neoos/services/deploy/nitro/provision-enclave-compute.sh
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=morpheus-nitro-signer-testnet.service multi-user.target
