[Unit]
Description=NeoOS TestNet-pinned Nitro compute and signer enclave
After=network-online.target docker.service nitro-enclaves-allocator.service
Wants=network-online.target docker.service nitro-enclaves-allocator.service

[Service]
Type=simple
EnvironmentFile=/opt/morpheus/nitro/morpheus-nitro-testnet.env
# Pin the file the launcher sources after systemd has merged EnvironmentFile=.
# Without this exec-time pin, an accidental install on the live host would source
# the default mainnet env and could overwrite the TestNet CID/port/network values.
ExecStart=/usr/bin/env MORPHEUS_NITRO_ENV=/opt/morpheus/nitro/morpheus-nitro-testnet.env /opt/neoos/services/deploy/nitro/start-nitro-signer.sh
Restart=always
RestartSec=5
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
