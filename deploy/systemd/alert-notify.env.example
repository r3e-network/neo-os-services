# /opt/morpheus/nitro/alert-notify.env  (chmod 600) — DO NOT COMMIT REAL VALUES
#
# Consumed by morpheus-alert@.service, the OnFailure= target for the feed pusher,
# feed monitor and feed topup units. Without ALERT_WEBHOOK_URL the notifier still
# writes the alert to the journal but exits 78 (EX_CONFIG), so an unconfigured
# alert path is itself visible in `systemctl --failed`.
#
# Comma-separated list; the alert is delivered if ANY endpoint accepts it.
# Any endpoint that accepts a JSON POST works (BetterStack incoming webhook,
# Alertmanager /api/v2/alerts proxy, Slack incoming webhook — the payload
# carries a top-level `text` field for renderers that expect one).
ALERT_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <value>` on every alert POST.
ALERT_WEBHOOK_TOKEN=

# Optional label identifying this box in the alert payload. Defaults to hostname().
ALERT_SOURCE=
