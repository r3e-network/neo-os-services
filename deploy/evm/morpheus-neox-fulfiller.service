[Unit]
Description=NeoOS Node NeoX fulfiller (NON-PRODUCTION COMPATIBILITY ONLY)
After=network-online.target morpheus-nitro-worker.service
Wants=network-online.target
ConditionPathExists=/opt/morpheus/nitro/ENABLE_NODE_NEOX_FULFILLER_COMPAT
Conflicts=morpheus-relayer.service morpheus-relayer-nitro.service

[Service]
Type=simple
EnvironmentFile=/opt/morpheus/nitro/neox-fulfiller.env
Environment=NODE_ENV=production
# run from the repo checkout so ethers/neon resolve from its node_modules
WorkingDirectory=/opt/neoos/services
ExecStart=/usr/bin/node deploy/evm/neox-fulfiller.mjs
Restart=always
RestartSec=5

# Deliberately no [Install] section. With NODE_ENV=production this compatibility
# binary exits 78 by design; it is never a production fallback for the Rust relayer.
