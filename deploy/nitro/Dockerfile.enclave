# Morpheus Oracle — Nitro enclave image, RUST-ONLY runtime.
#
# The measured boundary runs TWO Rust binaries and nothing else: nitro_init
# (crates/nitro-init — PID 1: loopback bring-up, the socat bridges, the
# readiness gate, the fail-stop watch) and the Rust trusted frontier it starts
# (workers/nitro-enclave-host → /app/bin/enclave_host). Migrated lanes are
# folded in-process — /health, /attestation,
# /provision's KMS state machine, /oracle/fulfill, /feed/sign, /sign/payload,
# /keys/derived, /compute/execute, /neodid/{bind,action-ticket,recovery-ticket},
# and the four oracle read lanes (/oracle/query, /oracle/smart-fetch,
# /oracle/decrypt, /oracle/message-reveal). Fulfillment request types whose
# Rust fold has not landed receive an explicit no-IO refusal; there is no
# execution fallback. No passthrough route manifest exists. This image
# therefore carries no Node runtime, no npm payload, no Go nsm helper
# (NsmAttestation talks to /dev/nsm directly), no /bin/sh entrypoint, and no
# copy of the pre-split merged server.
#
# Rollback is an EIF swap, not an in-image second runtime:
#   * the pre-split merged Node server (deploy/nitro/enclave-server.mjs) and
#     its Dockerfile stages remain in the repository; building the previous
#     enclave EIF from git history is the full-runtime rollback path. nitro-cli
#     measures per build, so operators keep every historical PCR0 to redeploy.
#
# REPRODUCIBLE BY CONSTRUCTION so the PCRs (PCR0/1/2 from `nitro-cli
# build-enclave`) are independently verifiable by a third party who rebuilds
# this image:
#   1. Base images are DIGEST-PINNED (@sha256), not tag-pinned (tags float).
#   2. Rust deps come from the committed Cargo.lock via `--locked`.
#   3. SOURCE_DATE_EPOCH + normalized mtimes remove build-time timestamps.
#
# Build context = repo root (see build-enclave-eif.sh, which runs
#   docker build -f deploy/nitro/Dockerfile.enclave <repo-root>).
#
# Reproducibility note: `nitro-cli build-enclave` derives PCR0/1/2 from the
# docker image, so determinism MUST come from this docker build. Both bases are
# digest-pinned below, so a rebuild cannot pick up a moved base; verify locally
# with `build-enclave-eif.sh --verify-reproducible`, which rebuilds with
# --no-cache (a cached second build would replay the same layers and prove
# nothing) and compares the resulting PCRs — image IDs only under --no-eif.

# ---------------------------------------------------------------------------
# Stage 1 — build the Rust trusted frontier (enclave_host).
# ---------------------------------------------------------------------------
# Pin the base to its resolved digest (sha256:82150a52…, taken 2026-09-02 from the
# Docker Hub registry API — the tag digest, i.e. exactly what
# `docker inspect --format '{{index .RepoDigests 0}}' rust:1.98-bookworm` reports;
# the 1.98-bookworm and 1.98.0-bookworm aliases resolve to this same manifest).
# The toolchain matches the local gate (rustc 1.98.0); bookworm glibc matches the
# runtime stage. BUMP deliberately — a base change is a PCR0 change, so it belongs
# in a commit that re-measures and re-pins the KMS key policy.
FROM rust:1.98-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS rustbuild
WORKDIR /build
ENV CARGO_TERM_COLOR=never

# The workspace graph (root manifest + lockfile + every member manifest) is
# what `--locked` resolves; copying sources separately keeps this layer cached
# across source edits.
COPY Cargo.toml Cargo.lock ./
# The root manifest carries [patch.crates-io] entries pointing at vendor/
# (boa_engine/boa_parser/boa_gc with their icu tilde-pins loosened — see the
# note in Cargo.toml); a patch whose path is missing fails the build, so the
# vendored manifests must land before fetch, next to the other manifests.
COPY vendor ./vendor
COPY crates/neo-os-core/Cargo.toml crates/neo-os-core/Cargo.toml
COPY crates/nitro-attest/Cargo.toml crates/nitro-attest/Cargo.toml
COPY crates/nitro-init/Cargo.toml crates/nitro-init/Cargo.toml
COPY crates/neo-os-compute/Cargo.toml crates/neo-os-compute/Cargo.toml
COPY workers/neo-signer/Cargo.toml workers/neo-signer/Cargo.toml
COPY workers/nitro-enclave-host/Cargo.toml workers/nitro-enclave-host/Cargo.toml
# Stub sources so `cargo build --locked` can resolve the graph before the real
# sources land (the classic dummy-main pre-compile trick; manifests are the
# resolution input, the stubs just let the fetch layer cache).
RUN mkdir -p crates/neo-os-core/src crates/nitro-attest/src crates/nitro-init/src \
      crates/neo-os-compute/src \
      workers/neo-signer/src workers/nitro-enclave-host/src \
  && echo "pub fn placeholder() {}" > crates/neo-os-core/src/lib.rs \
  && echo "pub fn placeholder() {}" > crates/nitro-attest/src/lib.rs \
  && echo "pub fn placeholder() {}" > crates/nitro-init/src/lib.rs \
  && echo "pub fn placeholder() {}" > crates/neo-os-compute/src/lib.rs \
  && echo "pub fn placeholder() {}" > workers/neo-signer/src/lib.rs \
  && echo "fn main() {}" > workers/nitro-enclave-host/src/main.rs
RUN cargo fetch --locked

COPY crates/neo-os-core/src crates/neo-os-core/src
COPY crates/nitro-attest/src crates/nitro-attest/src
COPY crates/nitro-init/src crates/nitro-init/src
COPY crates/neo-os-compute/src crates/neo-os-compute/src
COPY workers/neo-signer/src workers/neo-signer/src
COPY workers/nitro-enclave-host/src workers/nitro-enclave-host/src
# Release build of the two binaries this image runs: the frontier and its PID 1
# supervisor. --locked fails if Cargo.lock is out of sync (no implicit lockfile
# mutation of the pinned graph). The binaries are deterministic for identical
# inputs + toolchain (edition/workspace settings are committed; no volatile
# -C metadata inputs).
RUN cargo build --release --locked \
      -p nitro-enclave-host --bin enclave_host \
      -p nitro-init --bin nitro_init

# ---------------------------------------------------------------------------
# Stage 2 — the runtime: debian slim + two Rust binaries (the PID 1 supervisor
# and the frontier it starts).
# ---------------------------------------------------------------------------
# Pinned to the base's resolved digest (sha256:88200866…, resolved 2026-09-02 from
# the Docker Hub registry API). Dockerfile.signer pins this exact digest too, so
# the two measured images share one base instead of drifting under a floating tag.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

# ca-certificates: the host performs END-TO-END TLS to the real provider
# hostnames through the enclave egress (the oracle read lanes + provider
# fetches; the vsock-proxy forwards only ciphertext and cannot MITM).
# socat: bridges vsock:8787 -> the internal server and the egress proxy port
# (nitro_init starts both, and they are the only AF_VSOCK speakers here).
# iproute2: nitro_init runs `ip link set dev lo up` before anything uses
# 127.0.0.1 (its own readiness probe + the localhost socat bridges), because
# whether a Nitro enclave kernel leaves `lo` up has never been observed on a box
# that could check, and the slim base ships no `ip`. PID 1 here runs as root, so
# the call needs no capability and costs nothing when `lo` is already up; the
# custody image is where it matters (USER signer) — see the verify-by-hand note
# in docs/runbooks/custody-enclave-deployment.md.
# Pin apt versions for reproducibility of the OS layer (apt drift changes PCR0).
# REFRESH: these versions track Debian bookworm and roll on security updates;
# when the build fails because a pinned version was superseded, look up the
# current bookworm version (https://sources.debian.org/api/src/<pkg>/ or
# `apt-cache policy <pkg>` inside the base image) and bump. Verified 2026-06-14.
#
# Reproducibility: besides pinning versions, we DELETE the apt/dpkg logs and
# caches in the SAME layer. /var/log/dpkg.log + /var/log/apt/history.log embed
# wall-clock timestamps IN THEIR CONTENT (not just mtime), so leaving them makes
# the layer's diff_id — and therefore PCR0/PCR2 — vary on every build. mtimes are
# normalized globally by the final SOURCE_DATE_EPOCH pass below.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates=20230311+deb12u1 \
       socat=1.7.4.4-2 \
       iproute2=6.1.0-3 \
  && rm -rf /var/lib/apt/lists/* /var/log/* /var/cache/* /var/lib/dpkg/*-old

WORKDIR /app

COPY --from=rustbuild /build/target/release/enclave_host /app/bin/enclave_host
COPY --from=rustbuild /build/target/release/nitro_init /app/bin/nitro_init
RUN chmod +x /app/bin/enclave_host /app/bin/nitro_init

# --- Reproducibility: strip build-time timestamps across the WHOLE rootfs. ---
# SOURCE_DATE_EPOCH = 2026-06-14T00:00:00Z (1749859200). nitro-cli derives
# PCR0/PCR2 from the FLATTENED image filesystem, so every file's final mtime must
# be fixed — not just /app. The apt layer (ca-certificates/socat + dpkg metadata
# under /usr,/etc,/var) otherwise carries build-time mtimes that flip PCR2 on each
# rebuild. This final pass normalizes the entire root device (-xdev skips the
# runtime-only /proc,/sys,/dev mounts) to the fixed epoch, so the flattened mtimes
# are deterministic regardless of which layer wrote each file. The cost is a
# whole-rootfs copy-up in this layer (build-host disk only); the EIF is unchanged.
# --no-dereference touches symlinks themselves (e.g. /etc/ssl/certs/*.0).
ENV SOURCE_DATE_EPOCH=1749859200
RUN find / -xdev -exec touch --no-dereference --date=@1749859200 {} + 2>/dev/null || true

# Force the no-MITM posture inside the enclave (see vsock-proxy.allowlist.yaml /
# design §3): never honor a host-supplied provider base-URL override. The full
# HTTPS-only network override is applied via runtime env on the box; this default
# closes the most dangerous override at the image level.
ENV MORPHEUS_ALLOW_UNSAFE_PROVIDER_BASE_URL_OVERRIDE=
# Fail-closed production markers the host reads: the runtime env gate on
# ALLOW_UNPINNED-style overrides and the decrypt gate's production reassert
# cannot be talked out of their posture by /provision.
ARG MORPHEUS_NETWORK=testnet
ARG SIGNER_SERVICE_URL=
ARG SIGNER_ROLE_ORACLE_VERIFIER_KEY_ID=
ARG SIGNER_ROLE_UPDATER_KEY_ID=
ARG SIGNER_ROLE_RELAYER_KEY_ID=
ARG SIGNER_ROLE_WORKER_KEY_ID=
ENV NODE_ENV=production
ENV MORPHEUS_NETWORK=${MORPHEUS_NETWORK}
ENV SIGNER_SERVICE_URL=${SIGNER_SERVICE_URL}
ENV SIGNER_ROLE_ORACLE_VERIFIER_KEY_ID=${SIGNER_ROLE_ORACLE_VERIFIER_KEY_ID}
ENV SIGNER_ROLE_UPDATER_KEY_ID=${SIGNER_ROLE_UPDATER_KEY_ID}
ENV SIGNER_ROLE_RELAYER_KEY_ID=${SIGNER_ROLE_RELAYER_KEY_ID}
ENV SIGNER_ROLE_WORKER_KEY_ID=${SIGNER_ROLE_WORKER_KEY_ID}
# Public vsock port the host bridges to (nitro_init forwards it to the internal
# port the frontier binds).
ENV NITRO_SIGNER_VSOCK_PORT=8787
ENV ENCLAVE_INTERNAL_PORT=8081
# Outbound egress (in-enclave HTTPS_PROXY -> parent vsock -> host allow-list
# proxy). nitro_init derives HTTPS_PROXY from these and hands it to every child;
# reqwest (the host's oracle/provider client) honors the standard proxy env
# names. CID 3 is the Nitro parent instance. These are defaults; nitro_init
# reads the same keys at boot.
ENV ENCLAVE_HOST_CID=3
ENV ENCLAVE_EGRESS_VSOCK_PORT=8788
ENV ENCLAVE_PROXY_PORT=3128

# PID 1 is Rust too: nitro_init brings loopback up, starts the egress bridge,
# the frontier and (once the frontier listens) the vsock bridge, then fail-stops
# the enclave when any of them goes away. See crates/nitro-init.
ENTRYPOINT ["/app/bin/nitro_init", "frontier"]
