# Node compatibility UI / CLI env example. This does not define the production
# Rust authority topology; both compatibility images must use immutable tags.
# Most runtime settings are packed into MORPHEUS_RUNTIME_CONFIG_JSON.
# Generate a real file (deploy/nitro/morpheus.<network>.env) from local .env via:
#   npm run render:nitro-compose-env:mainnet
#   npm run render:nitro-compose-env:testnet
# `npm run render:nitro-compose-env` is the mainnet alias.
# No field here is a signing key: S5 retired plaintext signer keys on every
# process, and every Neo N3 signature is custody-side (SIGNER_ROLE_*_KEY_ID).
# For bilingual explanations of the variables, read `docs/ENVIRONMENT.md`.

MORPHEUS_COMPAT_NITRO_WORKER_IMAGE=ghcr.io/r3e-network/neo-os-services-nitro-worker:sha-replace-me
MORPHEUS_COMPAT_RELAYER_IMAGE=ghcr.io/r3e-network/neo-os-services-relayer:sha-replace-me
NITRO_WORKER_PORT=8080

# Shared auth between web/serverless and Nitro worker.
NITRO_SHARED_SECRET=replace-me
NITRO_API_TOKEN=
CLOUDFLARE_DNS_API_TOKEN=
CERTBOT_EMAIL=
MORPHEUS_CUSTOM_DOMAIN=
MORPHEUS_INGRESS_PORT=443
MORPHEUS_INGRESS_SET_CAA=false
MORPHEUS_HEARTBEAT_TIMEOUT_MS=3000
MORPHEUS_BETTERSTACK_CRON_FEED_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_CRON_FEED_FAILURE_URL=
MORPHEUS_BETTERSTACK_CRON_HEALTH_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_RELAYER_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_RELAYER_FEED_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_RELAYER_FAILURE_URL=
MORPHEUS_BETTERSTACK_CONTROL_FEED_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_CONTROL_FEED_FAILURE_URL=
MORPHEUS_BETTERSTACK_CONTROL_CALLBACK_FAILURE_URL=
MORPHEUS_BETTERSTACK_CONTROL_AUTOMATION_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_CONTROL_AUTOMATION_FAILURE_URL=
MORPHEUS_BETTERSTACK_LOG_INGESTING_HOST=
MORPHEUS_BETTERSTACK_LOG_SOURCE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MORPHEUS_UPSTASH_GUARDS_ENABLED=false
MORPHEUS_UPSTASH_FAIL_CLOSED=false
MORPHEUS_RATE_LIMIT_PAYMASTER_AUTHORIZE_MAX=20
MORPHEUS_RATE_LIMIT_RELAY_TRANSACTION_MAX=20
MORPHEUS_RATE_LIMIT_COMPUTE_EXECUTE_MAX=10
MORPHEUS_RATE_LIMIT_VRF_RANDOM_MAX=15
MORPHEUS_RATE_LIMIT_ORACLE_QUERY_MAX=30
GRAFANA_CLOUD_PROMETHEUS_PUSH_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MORPHEUS_PROVIDER_CONFIG_API_KEY=
MORPHEUS_RELAYER_ADMIN_API_KEY=
MORPHEUS_SIGNING_ADMIN_API_KEY=
MORPHEUS_RELAY_ADMIN_API_KEY=
MORPHEUS_OPERATOR_API_KEY=
# All Neo N3 signing (relayer, worker sign lane, worker tx-relay lane) is
# custody-only (see docs/SIGNER_SERVICE.md §5): none of them read a WIF. The
# custody service runs inside the Nitro enclave behind its vsock-to-loopback
# bridge; SIGNER_SERVICE_URL points at that bridge. Consumers talk to custody
# directly under their own caller token
# (/signer/api/v1/sign/raw and /sign/transaction).
SIGNER_SERVICE_URL=
SIGNER_SERVICE_TOKEN=
SIGNER_ROLE_UPDATER_KEY_ID=
SIGNER_ROLE_ORACLE_VERIFIER_KEY_ID=
SIGNER_ROLE_WORKER_KEY_ID=
# NeoX transaction submission and fulfillment-proof signing are distinct roles.
SIGNER_ROLE_NEOX_UPDATER_KEY_ID=
SIGNER_ROLE_NEOX_VERIFIER_KEY_ID=
# NeoX production delivery is Rust-authoritative. These fields remain here only
# for pinned Node compatibility images; never provide host private keys.
MORPHEUS_RELAYER_NEOX_RPC_URL=
MORPHEUS_RELAYER_NEOX_RPC_URLS=
MORPHEUS_RELAYER_NEOX_CHAIN_ID=47763
MORPHEUS_RELAYER_NEOX_DATAFEED=
MORPHEUS_RELAYER_NEOX_FEED_GAS_LIMIT=2000000
# Optional: custody key id funding updater fee top-ups (auto top-up only).
SIGNER_ROLE_FEE_FUNDER_KEY_ID=

# Packed runtime config consumed by the compatibility worker / relayer. It carries
# no WIF or private key; the resolver refuses a plaintext Neo N3 key by name.
MORPHEUS_RUNTIME_CONFIG_JSON={"MORPHEUS_PROVIDER_CONFIG_API_KEY":"","MORPHEUS_RELAYER_ADMIN_API_KEY":"","MORPHEUS_SIGNING_ADMIN_API_KEY":"","MORPHEUS_RELAY_ADMIN_API_KEY":"","MORPHEUS_OPERATOR_API_KEY":"","MORPHEUS_NETWORK":"mainnet","NEO_RPC_URL":"https://api.n3index.dev/mainnet","NEO_NETWORK_MAGIC":"860833102","CONTRACT_MORPHEUS_ORACLE_HASH":"0xf54d8584ef82315c1800373272ab08ae0db2d5ef","CONTRACT_ORACLE_CALLBACK_CONSUMER_HASH":"0xe1226268f2fe08bea67fb29e1c8fda0d7c8e9844","CONTRACT_MORPHEUS_DATAFEED_HASH":"0x03013f49c42a14546c8bbe58f9d434c3517fccab","MORPHEUS_RELAYER_MODE":"combined","MORPHEUS_DURABLE_QUEUE_ENABLED":"true","MORPHEUS_DURABLE_QUEUE_FAIL_CLOSED":"true","MORPHEUS_DURABLE_QUEUE_SYNC_LIMIT":"200","MORPHEUS_DURABLE_QUEUE_STALE_PROCESSING_MS":"120000","MORPHEUS_RELAYER_NEO_N3_SCAN_MODE":"","MORPHEUS_RELAYER_NEO_N3_START_REQUEST_ID":"","WEB3AUTH_CLIENT_ID":"","WEB3AUTH_JWKS_URL":"https://api-auth.web3auth.io/.well-known/jwks.json","TWELVEDATA_API_KEY":"","MORPHEUS_FEED_PROJECT_SLUG":"morpheus","MORPHEUS_FEED_PROVIDER":"twelvedata","MORPHEUS_AUTOMATION_ENABLED":"false","MORPHEUS_AUTOMATION_BATCH_SIZE":"50","MORPHEUS_AUTOMATION_MAX_QUEUED_PER_TICK":"10","MORPHEUS_AUTOMATION_PRICE_PAIRS_PER_TICK":"64","MORPHEUS_AUTOMATION_DEFAULT_PRICE_COOLDOWN_MS":"60000","MORPHEUS_RELAYER_NEO_N3_START_BLOCK":"","ORACLE_TIMEOUT":"20s","ORACLE_MAX_PROVIDER_BODY_BYTES":"65536","ORACLE_SCRIPT_TIMEOUT_MS":"2000","ORACLE_WASM_TIMEOUT_MS":"30000","COMPUTE_SCRIPT_TIMEOUT_MS":"2000","COMPUTE_WASM_TIMEOUT_MS":"30000","MORPHEUS_WASM_TIMEOUT_MS":"30000","NITRO_USE_DERIVED_KEYS":"true","NITRO_EMIT_ATTESTATION":"true","NITRO_ORACLE_KEYSTORE_PATH":"/data/morpheus/oracle-key.json","MORPHEUS_FEED_PROVIDERS":"twelvedata","MORPHEUS_FEED_SYMBOLS":"TWELVEDATA:NEO-USD,TWELVEDATA:GAS-USD,TWELVEDATA:BTC-USD,TWELVEDATA:ETH-USD,TWELVEDATA:SOL-USD,TWELVEDATA:TRX-USD,TWELVEDATA:PAXG-USD,TWELVEDATA:WTI-USD,TWELVEDATA:BRENT-USD,TWELVEDATA:NATGAS-USD,TWELVEDATA:WHEAT-USD,TWELVEDATA:CORN-USD,TWELVEDATA:SOY-USD,TWELVEDATA:USDT-USD,TWELVEDATA:USDC-USD,TWELVEDATA:BNB-USD,TWELVEDATA:XRP-USD,TWELVEDATA:DOGE-USD,TWELVEDATA:AAPL-USD,TWELVEDATA:GOOGL-USD,TWELVEDATA:MSFT-USD,TWELVEDATA:AMZN-USD,TWELVEDATA:TSLA-USD,TWELVEDATA:META-USD,TWELVEDATA:NVDA-USD,TWELVEDATA:SPY-USD,TWELVEDATA:QQQ-USD,TWELVEDATA:GLD-USD,TWELVEDATA:EUR-USD,TWELVEDATA:GBP-USD,TWELVEDATA:JPY-USD,TWELVEDATA:CNY-USD","MORPHEUS_FEED_CHANGE_THRESHOLD_BPS":"10","MORPHEUS_FEED_MIN_UPDATE_INTERVAL_MS":"60000","MORPHEUS_FEED_SYNC_INTERVAL_MS":"60000","MORPHEUS_FEED_SYNC_TIMEOUT_MS":"120000","MORPHEUS_FEED_PAIR_REGISTRY_JSON":"","MORPHEUS_FEED_BOOTSTRAP_SUPABASE_ENABLED":"true","MORPHEUS_FEED_SNAPSHOT_SUPABASE_ENABLED":"true"}
MORPHEUS_ACTIVE_CHAINS=neo_n3
MORPHEUS_PAYMASTER_TESTNET_ENABLED=false
MORPHEUS_PAYMASTER_TESTNET_POLICY_ID=testnet-default
MORPHEUS_PAYMASTER_TESTNET_MAX_GAS_UNITS=5000000
MORPHEUS_PAYMASTER_TESTNET_ALLOW_TARGETS=
MORPHEUS_PAYMASTER_TESTNET_ALLOW_USEROP_TARGETS=
MORPHEUS_PAYMASTER_TESTNET_ALLOW_METHODS=
MORPHEUS_PAYMASTER_TESTNET_ALLOW_ACCOUNTS=
MORPHEUS_PAYMASTER_TESTNET_BLOCK_ACCOUNTS=
MORPHEUS_PAYMASTER_TESTNET_ALLOW_DAPPS=
MORPHEUS_PAYMASTER_TESTNET_TTL_MS=15m
# Transaction sponsorship is disabled by default. Enable only after deploying
# strict paymaster policies and verifying operation_hash-bound relay requests.
MORPHEUS_ALLOW_TRANSACTION_SPONSORSHIP=false
MORPHEUS_PAYMASTER_MAINNET_ENABLED=false
MORPHEUS_PAYMASTER_MAINNET_POLICY_ID=mainnet-default
MORPHEUS_PAYMASTER_MAINNET_MAX_GAS_UNITS=5000000
MORPHEUS_PAYMASTER_MAINNET_ALLOW_TARGETS=
MORPHEUS_PAYMASTER_MAINNET_ALLOW_USEROP_TARGETS=
MORPHEUS_PAYMASTER_MAINNET_ALLOW_METHODS=
MORPHEUS_PAYMASTER_MAINNET_ALLOW_ACCOUNTS=
MORPHEUS_PAYMASTER_MAINNET_BLOCK_ACCOUNTS=
MORPHEUS_PAYMASTER_MAINNET_ALLOW_DAPPS=
MORPHEUS_PAYMASTER_MAINNET_TTL_MS=15m
