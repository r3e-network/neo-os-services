# Production Rust relayer. Neo N3 and NeoX request/feed lanes are authoritative
# after config:validate succeeds. This conservative example starts with Neo N3
# requests; use active chains `neo_n3,neox` and mode `requests_only`,
# `feed_only`, or `combined` as required. Feed modes also require feed sync,
# symbols, and the selected chain's datafeed contract. Automation is a separate
# unavailable commit protocol and must remain disabled.
NODE_ENV=production
MORPHEUS_NETWORK=mainnet
MORPHEUS_ACTIVE_CHAINS=neo_n3
MORPHEUS_RELAYER_MODE=requests_only
MORPHEUS_DELIVERY_PROTOCOL=v2
# Apply the durable v2 migration and stop every old writer before this cutover.
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional: two independent archive RPCs used to prove expired N3 bytes absent.
# Ordinary confirmation never requires this setting; unknown expiry fails closed.
MORPHEUS_N3_RECONCILIATION_ARCHIVE_RPC_URLS=
MORPHEUS_AUTOMATION_ENABLED=false
MORPHEUS_FEED_SYNC_ENABLED=false
MORPHEUS_FEED_SYMBOLS=
MORPHEUS_RELAYER_INSTANCE_ID=replace-with-stable-relayer-instance-id
MORPHEUS_RELAYER_STATE_FILE=/var/lib/neo-os-relayer/state.mainnet.requests-only.json

# Frontier compute and separate custody signer. Both bind loopback on the host.
# These are two distinct caller domains; never reuse either bearer value.
MORPHEUS_RUNTIME_URL=http://127.0.0.1:8787
MORPHEUS_RUNTIME_TOKEN=replace-with-frontier-runtime-bearer-token
MORPHEUS_RELAYER_ENCLAVE_FULFILL=true
MORPHEUS_RELAYER_ENCLAVE_FULFILL_URL=http://127.0.0.1:8787
SIGNER_SERVICE_URL=http://127.0.0.1:8789
# The Rust relayer currently authenticates with Bearer. Provision a dedicated
# bearer caller in custody and place its token here; a workload-ed25519 caller
# has no bearer token and is not yet supported by the relayer transport.
SIGNER_SERVICE_TOKEN=replace-with-dedicated-relayer-bearer-caller-token

# Neo N3 discovery / confirmation and measured custody identities.
NEO_RPC_URLS_MAINNET=https://mainnet1.neo.coz.io:443
CONTRACT_MORPHEUS_ORACLE_HASH_MAINNET=replace-with-mainnet-script-hash
CONTRACT_MORPHEUS_DATAFEED_HASH_MAINNET=
SIGNER_ROLE_UPDATER_KEY_ID=replace-with-n3-updater-key-id
SIGNER_ROLE_ORACLE_VERIFIER_KEY_ID=replace-with-n3-verifier-key-id
MORPHEUS_RELAYER_NEO_N3_AUTO_TOPUP_ENABLED=false

# NeoX request and feed delivery are production Rust lanes when `neox` is in
# MORPHEUS_ACTIVE_CHAINS. Set the oracle contract for request/combined mode and
# the datafeed contract plus feed settings for feed/combined mode.
MORPHEUS_RELAYER_NEOX_RPC_URL=
MORPHEUS_RELAYER_NEOX_RPC_URLS=
MORPHEUS_RELAYER_NEOX_CHAIN_ID=47763
MORPHEUS_RELAYER_NEOX_ORACLE=
# EIP-1559 submission and semantic EIP-191 proof signing are separate custody
# authorities. These key ids must not be equal.
SIGNER_ROLE_NEOX_UPDATER_KEY_ID=replace-with-neox-updater-key-id
SIGNER_ROLE_NEOX_VERIFIER_KEY_ID=replace-with-neox-verifier-key-id
MORPHEUS_RELAYER_NEOX_DATAFEED=
MORPHEUS_RELAYER_NEOX_FEED_GAS_LIMIT=2000000
