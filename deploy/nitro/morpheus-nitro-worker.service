[Unit]
Description=NeoOS Node compute worker (COMPATIBILITY ONLY; not production authority)
After=network-online.target morpheus-nitro-signer.service
ConditionPathExists=/opt/morpheus/nitro/ENABLE_NODE_COMPAT

[Service]
Type=simple
User=morpheus
WorkingDirectory=/opt/neoos/services/workers/nitro-worker
EnvironmentFile=/opt/morpheus/nitro/nitro-worker.env
# Fail-closed: activates the child-process sandbox guard (permission-guard.js).
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

# Deliberately no [Install] section. This parity runtime can only be started
# manually after an operator creates ENABLE_NODE_COMPAT; it is never enabled as
# a default production authority.
