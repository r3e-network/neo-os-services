# Provisioning template for a TestNet-pinned frontier: the file
# deploy/nitro/start-nitro-signer.sh reads (MORPHEUS_NITRO_SIGNER_ENV in
# morpheus-nitro-testnet.env). Copy to
# /opt/morpheus/nitro/morpheus-nitro-signer-testnet.env (chmod 600).
# Do not copy the live mainnet signer env onto a TestNet host. It holds no
# signing key: Neo N3 signing is custody-side (SIGNER_ROLE_*_KEY_ID), so there is
# no Neo N3 signer ciphertext to provision.

MORPHEUS_NETWORK=testnet
PORT=8080
NITRO_SIGNER_VSOCK_PORT=8787

NITRO_SIGNER_TOKEN=
MORPHEUS_RUNTIME_TOKEN=
# KMS plaintext must be JSON:
# {"purpose":"neoos/nitro-runtime-auth/v1","network":"testnet","version":1,"token":"<same token>"}
MORPHEUS_RUNTIME_TOKEN_KMS_CIPHERTEXT_BASE64=

# The frontier's custody caller envelope; start-nitro-signer.sh refuses to
# provision without it. KMS plaintext must be JSON (see docs/NITRO_DEPLOYMENT.md):
# {"purpose":"neoos/custody-caller-token/v1","network":"testnet","version":1,"token":"<raw_sign caller token>","semantic_token":"<distinct sign caller token>"}
# TestNet CiphertextBlob values only; do not paste mainnet blobs. KMS policy must
# allow the TestNet EIF measurement.
SIGNER_SERVICE_TOKEN_KMS_CIPHERTEXT_BASE64=
