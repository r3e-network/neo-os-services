# Provisioning template for a TestNet-pinned KMS-attested enclave.
# Copy to /opt/morpheus/nitro/morpheus-nitro-signer-testnet.env (chmod 600).
# Do not copy the live mainnet signer env onto a TestNet host.

MORPHEUS_NETWORK=testnet
PORT=8080
NITRO_SIGNER_VSOCK_PORT=8787

NITRO_SIGNER_TOKEN=
MORPHEUS_RUNTIME_TOKEN=
# KMS plaintext must be JSON:
# {"purpose":"neoos/nitro-runtime-auth/v1","network":"testnet","version":1,"token":"<same token>"}
MORPHEUS_RUNTIME_TOKEN_KMS_CIPHERTEXT_BASE64=

# TestNet updater / verifier CiphertextBlob values only. Do not paste
# mainnet blobs. KMS policy must allow the TestNet EIF measurement.
MORPHEUS_UPDATER_NEO_N3_KMS_CIPHERTEXT_BASE64=
MORPHEUS_ORACLE_VERIFIER_KMS_CIPHERTEXT_BASE64=
