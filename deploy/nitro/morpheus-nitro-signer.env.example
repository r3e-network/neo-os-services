# Provisioning template for the merged KMS-attested enclave. The retired
# standalone signer rejects plaintext WIF/private-key fields.

MORPHEUS_NETWORK=mainnet
PORT=8080
NITRO_SIGNER_VSOCK_PORT=8787

# Runtime transport authentication. This does not establish trust against the
# parent host; semantic signing policy and attested KMS key release do that.
NITRO_SIGNER_TOKEN=
MORPHEUS_RUNTIME_TOKEN=
# KMS plaintext must be JSON:
# {"purpose":"neoos/nitro-runtime-auth/v1","network":"mainnet","version":1,"token":"<same token>"}
MORPHEUS_RUNTIME_TOKEN_KMS_CIPHERTEXT_BASE64=

# KMS CiphertextBlob values only. KMS policy must require the expected enclave
# PCR, and the decrypted keys must match config/signer-identities.json.
MORPHEUS_UPDATER_NEO_N3_KMS_CIPHERTEXT_BASE64=
MORPHEUS_ORACLE_VERIFIER_KMS_CIPHERTEXT_BASE64=
