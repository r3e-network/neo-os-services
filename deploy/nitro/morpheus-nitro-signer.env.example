# Provisioning template for the frontier: the file
# deploy/nitro/start-nitro-signer.sh reads (MORPHEUS_NITRO_SIGNER_ENV, default
# /opt/morpheus/nitro/morpheus-nitro-signer.env). `npm run render:nitro-env`
# renders it. It holds no signing key: Neo N3 signing is custody-side
# (SIGNER_ROLE_*_KEY_ID), so there is no Neo N3 signer ciphertext to provision,
# and the frontier refuses plaintext WIF/private-key fields.

MORPHEUS_NETWORK=mainnet
PORT=8080
NITRO_SIGNER_VSOCK_PORT=8787

# Runtime transport authentication. This does not establish trust against the
# parent host; semantic signing policy and attested KMS key release do that.
NITRO_SIGNER_TOKEN=
MORPHEUS_RUNTIME_TOKEN=
# KMS plaintext must be JSON:
# {"purpose":"neoos/nitro-runtime-auth/v1","network":"mainnet","version":1,"token":"<same token>"}
MORPHEUS_RUNTIME_TOKEN_KMS_CIPHERTEXT_BASE64=

# The frontier's custody caller envelope; start-nitro-signer.sh refuses to
# provision without it. KMS plaintext must be JSON (see docs/NITRO_DEPLOYMENT.md):
# {"purpose":"neoos/custody-caller-token/v1","network":"mainnet","version":1,"token":"<raw_sign caller token>","semantic_token":"<distinct sign caller token>"}
# KMS CiphertextBlob values only. KMS policy must require the expected enclave PCR.
SIGNER_SERVICE_TOKEN_KMS_CIPHERTEXT_BASE64=
