# Copy this file to /opt/morpheus/nitro/morpheus-nitro.env on the Nitro host.
# Do not commit the real file. It contains only host-side config. Nitro CLI
# cannot pass runtime env files into enclaves; signer secrets must be sealed
# with KMS/attestation and decrypted from inside the enclave.

MORPHEUS_NETWORK=mainnet
MORPHEUS_NITRO_IMAGE=neoos-services-enclave:latest
MORPHEUS_NITRO_EIF=/opt/morpheus/nitro/morpheus-oracle.eif
MORPHEUS_NITRO_CID=16
MORPHEUS_NITRO_CPU_COUNT=2
MORPHEUS_NITRO_MEMORY_MIB=2048
MORPHEUS_NITRO_HOST_PORT=8787
MORPHEUS_NITRO_VSOCK_PORT=8787

# The custody enclave is a SECOND enclave on this host, so it needs its own CID
# and host port. start-nitro-custody.sh terminates whatever enclave already
# holds its CID before booting, and its socat bridge cannot share a TCP port
# with the frontier's — a collision kills the frontier and then fails to bind.
# The vsock port stays 8787: it is per-enclave (CID 17, not 16), and it must
# match NITRO_SIGNER_VSOCK_PORT baked into the measured custody image.
MORPHEUS_CUSTODY_IMAGE=morpheus-custody-enclave:latest
MORPHEUS_CUSTODY_EIF=/opt/morpheus/nitro/morpheus-custody.eif
MORPHEUS_CUSTODY_CID=17
MORPHEUS_CUSTODY_CPU_COUNT=2
MORPHEUS_CUSTODY_MEMORY_MIB=2048
MORPHEUS_CUSTODY_HOST_PORT=8789
MORPHEUS_CUSTODY_VSOCK_PORT=8787
# The two KMS ciphertexts plus the plaintext transport token, mode 0600, never
# committed. Without this file the enclave boots sealed: /health answers
# unprovisioned and every custody route refuses with 503.
MORPHEUS_CUSTODY_SIGNER_ENV=/opt/morpheus/nitro/morpheus-custody-signer.env

# Relayer talks to the local host proxy, which forwards to the enclave over vsock.
MORPHEUS_RUNTIME_URL=http://127.0.0.1:8787
NITRO_API_URL=http://127.0.0.1:8787
# Signing goes to the OTHER enclave: every Neo N3 signature (relayer, worker
# sign and tx-relay lanes, feed-pusher top-ups) is custody-side, under a
# per-caller token. SIGNER_SERVICE_TOKEN is a secret and belongs in the
# rendered env, not here.
SIGNER_SERVICE_URL=http://127.0.0.1:8789
NITRO_USE_DERIVED_KEYS=true
