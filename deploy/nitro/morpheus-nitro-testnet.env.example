# Copy to /opt/morpheus/nitro/morpheus-nitro-testnet.env on a DISTINCT
# TestNet Nitro host (chmod 600). Do not install this file on
# i-0c52851f134db20ee and do not reuse the live mainnet CID, host port,
# EIF filename, or signer env.
#
# CID and host port. start-nitro-signer.sh defaults the frontier to CID 16 /
# host port 8787 (the live mainnet frontier's values) and start-nitro-custody.sh
# defaults custody to CID 17 / host port 8789; the egress proxy uses 8788. The
# TestNet frontier takes none of them: CID 18 / host port 8791, the candidate in
# deploy/nitro/TESTNET-RUNTIME-REMEDIATION.md (confirm both are free on the host
# first). start-nitro-signer.sh terminates whatever enclave holds its CID (a
# testnet-pinned run refuses a non-testnet occupant), and a shared host port
# fails the socat bind. The vsock port stays 8787: it is per-enclave and baked
# into the measured image.

MORPHEUS_NETWORK=testnet
MORPHEUS_NITRO_IMAGE=neoos-services-enclave:testnet
MORPHEUS_NITRO_EIF=/opt/morpheus/nitro/morpheus-oracle-testnet.eif
MORPHEUS_NITRO_SIGNER_ENV=/opt/morpheus/nitro/morpheus-nitro-signer-testnet.env
MORPHEUS_NITRO_CID=18
MORPHEUS_NITRO_CPU_COUNT=2
MORPHEUS_NITRO_MEMORY_MIB=2048
MORPHEUS_NITRO_HOST_PORT=8791
MORPHEUS_NITRO_VSOCK_PORT=8787

# Relayer / pusher talk to the TestNet frontier's host bridge only.
MORPHEUS_RUNTIME_URL=http://127.0.0.1:8791
NITRO_API_URL=http://127.0.0.1:8791
NITRO_USE_DERIVED_KEYS=true
