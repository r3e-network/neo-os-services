# Copy to /opt/morpheus/nitro/morpheus-nitro-testnet.env on the approved
# single Nitro host (chmod 600). Mainnet and TestNet use separate profiles,
# enclave CIDs, ports, EIFs, and state files on that host. Do not create a
# second TestNet server and do not install this profile on an unapproved host.
#
# CID and host port. start-nitro-signer.sh defaults the mainnet frontier to CID
# 16 / host port 8787, custody defaults to CID 17 / host port 8789, and the
# egress proxy uses 8788. The TestNet profile reserves CID 18 / host port 8791
# on this same host; confirm capacity and both bindings before starting it.
# start-nitro-signer.sh refuses a non-TestNet occupant at the TestNet CID, and
# a shared host port fails the socat bind. The vsock port stays 8787: it is
# per-enclave and baked into the measured image.

MORPHEUS_NETWORK=testnet
MORPHEUS_NITRO_IMAGE=neoos-services-enclave:testnet
MORPHEUS_NITRO_EIF=/opt/morpheus/nitro/morpheus-oracle-testnet.eif
MORPHEUS_NITRO_SIGNER_ENV=/opt/morpheus/nitro/morpheus-nitro-signer-testnet.env
MORPHEUS_NITRO_CID=18
MORPHEUS_NITRO_CPU_COUNT=2
MORPHEUS_NITRO_MEMORY_MIB=2048
MORPHEUS_NITRO_HOST_PORT=8791
MORPHEUS_NITRO_VSOCK_PORT=8787

# Relayer / pusher talk to the TestNet frontier's host bridge only.
MORPHEUS_RUNTIME_URL=http://127.0.0.1:8791
NITRO_API_URL=http://127.0.0.1:8791
NITRO_USE_DERIVED_KEYS=true
