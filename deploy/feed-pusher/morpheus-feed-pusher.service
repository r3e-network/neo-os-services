[Unit]
Description=Morpheus Node DataFeed pusher - Neo N3 (COMPATIBILITY ONLY)
After=network-online.target morpheus-nitro-signer.service
Wants=network-online.target
ConditionPathExists=/opt/morpheus/nitro/ENABLE_NODE_FEED_PUSHER_COMPAT
Conflicts=morpheus-relayer.service morpheus-relayer-nitro.service
# A pusher that stops writing is the outage; route its exit code to a human.
OnFailure=morpheus-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/opt/morpheus/nitro/feed-pusher.env
Environment=NODE_ENV=production
# Neo N3 lane only - Neo X runs on its own faster timer (feed-pusher-neox).
Environment=FEED_CHAINS=neo-n3
WorkingDirectory=/opt/neoos/services/deploy/feed-pusher
ExecStart=/usr/bin/node feed-pusher.mjs
