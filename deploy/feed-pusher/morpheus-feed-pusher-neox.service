[Unit]
Description=Morpheus Node DataFeed pusher - Neo X (COMPATIBILITY ONLY)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/morpheus/nitro/ENABLE_NODE_FEED_PUSHER_COMPAT
Conflicts=morpheus-relayer.service morpheus-relayer-nitro.service
[Service]
Type=oneshot
EnvironmentFile=/opt/morpheus/nitro/feed-pusher.env
Environment=NODE_ENV=production
# Neo X lane only - runs on a faster (2 min) cadence than Neo N3 (5 min).
Environment=FEED_CHAINS=neox
WorkingDirectory=/opt/neoos/services/deploy/feed-pusher
ExecStart=/usr/bin/node feed-pusher.mjs
