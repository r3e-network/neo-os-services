[Unit]
Description=Morpheus feed freshness + updater GAS monitor (fails visibly on stale/low)
# The monitor exits 1 on a stale feed or low updater GAS and 2 on RPC failure.
# Until 2026-08 nothing was subscribed to that exit code: RUNBOOK.md named a
# human running `systemctl is-failed` as the detection mechanism, which is how a
# 19-day mainnet feed outage (2026-07-29 -> 2026-08-17) went unnoticed. OnFailure
# hands the failed unit name to the alert notifier so the exit code reaches a
# person.
OnFailure=morpheus-alert@%n.service

[Service]
Type=oneshot
# Without this the monitor could not see MAX_AGE_SEC, MONITOR_PROM_TEXTFILE,
# TRADFI_* or MONITOR_NETWORK at all — they are documented in
# feed-pusher.env.example but only the pusher unit loaded that file, so every
# documented monitor knob was silently inert. `-` keeps the unit startable on a
# box that has not created the file yet.
EnvironmentFile=-/opt/morpheus/nitro/feed-pusher.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/neoos/services/deploy/feed-pusher
ExecStart=/usr/bin/node feed-monitor.mjs
