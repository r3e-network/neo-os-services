# NODE COMPATIBILITY ONLY. Production feeds use neo-os-relayer; these Node
# writers require explicit compatibility markers and conflict with Rust units.
# /opt/morpheus/nitro/feed-pusher.env  (chmod 600) — DO NOT COMMIT REAL VALUES
TD_KEY=<twelvedata-api-key>
RUNTIME_TOKEN=<copied from MORPHEUS_RUNTIME_TOKEN in morpheus-relayer.env>
# Network, chain lane, signer URL, and state/log/prom paths are reserved. systemd
# EnvironmentFile= overrides Environment=, so leftover FEED_NETWORK / PUSH_* /
# MONITOR_* / TOPUP_LOG / SIGNER_URL / PUSH_PROM_TEXTFILE values here cannot be
# trusted. Units pin them at exec time via ExecStart=/usr/bin/env … — do not
# set those keys here.
# FEED_RPC is not read; use FEED_RPCS (comma-separated) only.
# Default network is mainnet (live box i-0c52851f134db20ee). Testnet is a
# different contract (0x9bea75cf…) that implements updateFeed, not updateFeeds.
# The host selects per-pair updateFeed only after FEED_NETWORK=testnet is
# magic-pinned and the public ABI is proven. Local code is not a live write.
# MORPHEUS_NETWORK is ignored by the feed writer.
# N3_FEED / FEED_MAGIC, if set, must match the selected FEED_NETWORK defaults
# or the process fails closed (no silent retarget). Do not pin a foreign hash
# or magic here. FEED_RPCS may rotate URLs; each URL is checked with getversion.
FEED_RPCS=https://api.n3index.dev/mainnet,https://rpc10.n3.nspcc.ru:10331,https://mainnet1.neo.coz.io:443
THRESHOLD_BPS=10
MAX_STALE_SEC=1800
# Price-sanity guard: reject a candidate that deviates from the existing on-chain
# price by more than MAX_DEVIATION_BPS (5000 = 50%). Bootstrap writes (no on-chain
# price yet) and zero/negative quotes are handled separately. Set to 0 to bypass
# for a genuine flash move (e.g. a real >50% candle), then re-set.
MAX_DEVIATION_BPS=5000
# Daily write budget — REQUIRED for a mainnet Neo N3 writer (the pusher refuses to start without
# it): the most transactions this pusher may broadcast per UTC day. The one past the cap is refused
# with a logged reason and the cycle fails (OnFailure pages); the count starts again at 00:00:00Z.
# Only the Neo N3 lane is budgeted. The cap counts WRITES, not GAS: GAS per day is at most the cap
# times the fee of one write, and that fee grows with the pairs a write updates. A write of two
# pairs cost 0.00606339 GAS (the live writer made 752 of them on 2026-09-30, about 4.56 GAS a day);
# a 28-pair batch cost 0.0501 GAS on 2026-08-20 (0.02474 GAS a cycle on average, 7.12 GAS a day).
# 288 is one write per 5-minute timer cycle and 360 leaves a quarter for re-broadcasts: set the cap
# from the fee of YOUR SYMBOLS list and fund the updater for cap x fee x the days of runway wanted
# (a cap of 360 is 2.18 GAS a day at 0.00606339, 18.0 GAS a day at 0.0501). The count is kept in
# <PUSH_STATUS>.write-budget.json (see FEED-OUTAGE-RUNBOOK.md).
MAX_WRITES_PER_DAY=360
GAS_WARN=8
# SYMBOLS = the full Neo N3 feed (NeoVM updater gas is cheap, so it carries forex/oil too).
# It MUST equal the keys of TD_SYMBOLS in feed-pusher.mjs, which must equal
# DEFAULT_FEED_BASE_SYMBOLS in apps/web/lib/feed-defaults.ts and DEFAULT_FEED_PAIRS in
# workers/nitro-worker/src/oracle/feed-registry.js. Run `npm run check:feeds:registries`
# after editing this line — a symbol here with no TD_SYMBOLS entry is refused by the
# pusher (it will not guess a provider symbol), and a symbol advertised by the web app
# but absent here can never be fresh, which is what made the health signal meaningless.
# Retired and NOT to be re-added: COPPER-USD (TwelveData HG1 is Homag Group AG, not
# copper), FLM-USD (TwelveData FLM/USD is FolmCoin, not Flamingo Finance).
# Neo X (EVM) pushes real gas every 2 min, so it runs a CRYPTO-ONLY subset via NEOX_SYMBOLS
# (TradFi forex EUR/GBP/JPY/CNY + commodities dropped). If NEOX_SYMBOLS is unset, Neo X
# falls back to the full SYMBOLS. PAXG (tokenized-gold ERC20) is kept as a crypto asset.
SYMBOLS=NEO-USD,GAS-USD,BTC-USD,ETH-USD,SOL-USD,TRX-USD,PAXG-USD,WTI-USD,BRENT-USD,NATGAS-USD,WHEAT-USD,CORN-USD,SOY-USD,USDT-USD,USDC-USD,BNB-USD,XRP-USD,DOGE-USD,AAPL-USD,GOOGL-USD,MSFT-USD,AMZN-USD,TSLA-USD,META-USD,NVDA-USD,SPY-USD,QQQ-USD,GLD-USD,EUR-USD,GBP-USD,JPY-USD,CNY-USD
NEOX_SYMBOLS=NEO-USD,GAS-USD,BTC-USD,ETH-USD,SOL-USD,TRX-USD,BNB-USD,XRP-USD,DOGE-USD,USDT-USD,USDC-USD,PAXG-USD

# ── feed-monitor.mjs (morpheus-feed-monitor.timer) ────────────────────────────
# Per-pair staleness: the monitor reads the FULL on-chain registry (getAllFeedRecords)
# and checks every pair, not just NEO-USD. MONITOR_PROM_TEXTFILE / MONITOR_NETWORK /
# MONITOR_LOG / MONITOR_STATUS / PUSH_LOG / PUSH_STATUS / MISSING_STATE /
# PUSH_PROM_TEXTFILE are reserved exec-time pins — do not assign them here.
# Writer confirmation metrics use PUSH_PROM_TEXTFILE (empty on mainnet/Neo X;
# TestNet pins feed-pusher-testnet.prom). Enable mainnet writer or monitor
# Prometheus textfiles with a systemd drop-in that changes the ExecStart pin.
# Those files are scrape surfaces only; they do not configure alert delivery.
# Runway: the monitor keeps its own balance samples (<MONITOR_STATUS>.balance-samples.json), derives
# the GAS burned per day from the last 24 hours and alerts at 14 / 7 / 3 days of runway (warning /
# high / critical), on a balance that cannot pay one write, on a stale pair and when the writer
# reports an unauthorized key, an expired plan or an exhausted quota. MIN_GAS (default 12) stays as a
# fixed floor beside it: set it below the funded balance, or MIN_GAS=0 to turn the floor off, or it
# alerts on every run. FEED_WRITE_FEE_GAS is the fee of one write of your writer (default 0.00606339,
# a two-pair write): it sets the "cannot pay one write" rule and the writes-a-day figure, not the runway.
#MIN_GAS=12
#FEED_WRITE_FEE_GAS=0.00606339
# TradFi pairs (forex/commodities) don't trade on weekends/holidays, so their
# staleness window widens to TRADFI_WEEKEND_AGE_SEC while the market is closed
# (avoids false weekend alerts). Crypto pairs keep MAX_AGE_SEC year-round.
TRADFI_PAIRS=EUR-USD,GBP-USD,JPY-USD,CNY-USD,WTI-USD,BRENT-USD,NATGAS-USD,WHEAT-USD,CORN-USD,SOY-USD
TRADFI_WEEKEND_AGE_SEC=270000
# Extra UTC holiday dates (YYYY-MM-DD, comma list) when TradFi markets close mid-week.
TRADFI_HOLIDAYS=

# /opt/morpheus/nitro/feed-topup.env (chmod 600, generated on box) —
# compatibility-only custody funding role; no private key is placed on the host.
SIGNER_SERVICE_URL=http://127.0.0.1:8788
SIGNER_SERVICE_TOKEN=<dedicated-fee-topup-bearer-caller-token>
SIGNER_ROLE_FEE_FUNDER_KEY_ID=<custody-fee-funder-key-id>
TOPUP_THRESHOLD=25
TOPUP_AMOUNT=40
