UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 ONLY when this deployment's traffic is terminated by Cloudflare, so
# cf-connecting-ip is written by the edge rather than by the caller. Leave unset
# on a raw *.vercel.app origin: there the header is attacker-controlled and
# trusting it lets a client mint a fresh rate-limit bucket per request.
TRUST_CF_CONNECTING_IP=

# Optional shared secret for POST /api/oracle/query. When set, callers must
# present it (Authorization: Bearer <value>, or x-admin-api-key) — the lane
# spends the server-held control-plane credential on the caller's behalf. When
# unset the lane stays open and is protected by the IP-keyed limiter alone.
MORPHEUS_ORACLE_QUERY_API_KEY=

CRON_SECRET=
MORPHEUS_BETTERSTACK_CRON_FEED_HEARTBEAT_URL=
MORPHEUS_BETTERSTACK_CRON_FEED_FAILURE_URL=
MORPHEUS_BETTERSTACK_CRON_HEALTH_HEARTBEAT_URL=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

CHECKLY_API_KEY=
CHECKLY_ACCOUNT_ID=
CHECKLY_PROJECT_NAME=
