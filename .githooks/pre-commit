#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Gitleaks is required before committing. Install it and retry." >&2
  exit 1
fi

echo "Running Gitleaks against staged changes..."
exec gitleaks git --staged --redact --no-banner --exit-code 1 "$repo_root"
