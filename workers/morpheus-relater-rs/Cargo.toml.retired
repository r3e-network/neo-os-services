[package]
name = "morpheus-relayer-rs"
version = "0.1.0"
edition = "2021"
description = "Morpheus Relayer - Multi-chain oracle request processor for Neo N3 and NeoX"
authors = ["NeoOS Team"]
license = "MIT"

[dependencies]
# Async runtime
tokio = { version = "1.35", features = ["full", "macros", "rt-multi-thread", "sync", "time", "signal"] }

# Serialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# HTTP client for RPC calls
reqwest = { version = "0.11", features = ["json"] }

# Configuration
config = "0.14"
dotenvy = "0.15"

# Error handling
anyhow = "1.0"
thiserror = "1.0"

# UUID
uuid = { version = "1.6", features = ["v4", "serde"] }

# Logging and metrics
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
metrics = "0.22"
metrics-exporter-prometheus = "0.13"

# Cryptography for Neo X/EVM chains
secp256k1 = "0.28"
sha2 = "0.10"
base64 = "0.21"
hex = "0.4"
rand = "0.8"

# Retry logic
async-retry = "0.4"
backoff = { version = "0.4", features = ["tokio"] }

# TEE attestation (placeholder)
tee-attestation = { path = "./crates/tee-attestation" }

[[bin]]
name = "morpheus-relayer-rs"
path = "src/main.rs"

[features]
default = []
testnet = []
mainnet = []
debug-mode = []
