{
  "name": "@r3e-network/neo-os-nitro-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bundle": "node src/worker.js",
    "start": "node src/server.js",
    "check": "find src \\( -name '*.js' -o -name '*.mjs' \\) -print | sort | xargs -n1 node --check && node --check worker.test.mjs",
    "test": "node --import ./src/test-support/isolate-aws-credentials.mjs --test --test-concurrency=1 worker.test.mjs src/*.test.mjs src/*/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@cityofzion/neon-js": "^5.10.1",
    "ethers": "^6.16.0",
    "jose": "^6.2.12",
    "undici": "^8.10.0"
  }
}
