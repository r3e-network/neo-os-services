{
  "family": "secret_redaction",
  "cases": [
    {
      "name": "bearer redacted",
      "kind": "redact",
      "input": "Authorization: Bearer aaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": "Authorization: Bearer [REDACTED]"
    },
    {
      "name": "bearer short credential kept",
      "kind": "redact",
      "input": "Bearer short",
      "expected": "Bearer short"
    },
    {
      "name": "basic scheme",
      "kind": "redact",
      "input": "Authorization: Basic abababababababababababababababab",
      "expected": "Authorization: Basic [REDACTED]"
    },
    {
      "name": "wif standalone",
      "kind": "redact",
      "input": "KwDiBf89QgGbjEhKnhXJuH7LrciVrZi3qYjgd9M7rFU73sVHnoWn",
      "expected": "[REDACTED-WIF]"
    },
    {
      "name": "wif in prose",
      "kind": "redact",
      "input": "the key KwDiBf89QgGbjEhKnhXJuH7LrciVrZi3qYjgd9M7rFU73sVHnoWn leaked",
      "expected": "the key [REDACTED-WIF] leaked"
    },
    {
      "name": "key context hex with 0x prefix",
      "kind": "redact",
      "input": "token=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expected": "token=[REDACTED]"
    },
    {
      "name": "key context hex plain",
      "kind": "redact",
      "input": "private_key: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expected": "private_key: [REDACTED]"
    },
    {
      "name": "key context hex uppercase",
      "kind": "redact",
      "input": "SECRET=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
      "expected": "SECRET=[REDACTED]"
    },
    {
      "name": "63 hex digits survive",
      "kind": "redact",
      "input": "seed: ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "expected": "seed: ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    },
    {
      "name": "bare 64 hex survives",
      "kind": "redact",
      "input": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expected": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    },
    {
      "name": "two secrets in one line",
      "kind": "redact",
      "input": "a=1 token=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb Bearer zzzzzzzzzzzzzzzzzzzz b=2",
      "expected": "a=1 token=[REDACTED] Bearer [REDACTED] b=2"
    },
    {
      "name": "prose untouched",
      "kind": "redact",
      "input": "plain text with no secrets at all",
      "expected": "plain text with no secrets at all"
    },
    {
      "name": "bearer exactly 20 chars",
      "kind": "redact",
      "input": "Bearer qqqqqqqqqqqqqqqqqqqq",
      "expected": "Bearer [REDACTED]"
    },
    {
      "name": "bearer 19 chars kept",
      "kind": "redact",
      "input": "Bearer qqqqqqqqqqqqqqqqqqq",
      "expected": "Bearer qqqqqqqqqqqqqqqqqqq"
    },
    {
      "name": "NEO_N3_WIF",
      "kind": "is_secret_name",
      "input": "NEO_N3_WIF",
      "expected": true
    },
    {
      "name": "MORPHEUS_N3_PRIVATE_KEY",
      "kind": "is_secret_name",
      "input": "MORPHEUS_N3_PRIVATE_KEY",
      "expected": true
    },
    {
      "name": "camelCase privateKey",
      "kind": "is_secret_name",
      "input": "privateKey",
      "expected": true
    },
    {
      "name": "compact privatekey",
      "kind": "is_secret_name",
      "input": "privatekey",
      "expected": true
    },
    {
      "name": "FOO_API_KEY",
      "kind": "is_secret_name",
      "input": "FOO_API_KEY",
      "expected": true
    },
    {
      "name": "service role key env",
      "kind": "is_secret_name",
      "input": "SUPABASE_SERVICE_ROLE_KEY",
      "expected": true
    },
    {
      "name": "camel serviceRoleKey",
      "kind": "is_secret_name",
      "input": "serviceRoleKey",
      "expected": true
    },
    {
      "name": "SIGNER_SERVICE_TOKEN",
      "kind": "is_secret_name",
      "input": "SIGNER_SERVICE_TOKEN",
      "expected": true
    },
    {
      "name": "seed",
      "kind": "is_secret_name",
      "input": "seed",
      "expected": true
    },
    {
      "name": "MNEMONIC",
      "kind": "is_secret_name",
      "input": "MNEMONIC",
      "expected": true
    },
    {
      "name": "authorization",
      "kind": "is_secret_name",
      "input": "authorization",
      "expected": true
    },
    {
      "name": "plain envelope",
      "kind": "is_secret_name",
      "input": "plain envelope",
      "expected": true
    },
    {
      "name": "PASSWORD_FIELD",
      "kind": "is_secret_name",
      "input": "PASSWORD_FIELD",
      "expected": true
    },
    {
      "name": "passphrase",
      "kind": "is_secret_name",
      "input": "passphrase",
      "expected": true
    },
    {
      "name": "plaintext_value",
      "kind": "is_secret_name",
      "input": "plaintext_value",
      "expected": true
    },
    {
      "name": "NEOX_UPDATER_PK is not name-secret",
      "kind": "is_secret_name",
      "input": "NEOX_UPDATER_PK",
      "expected": false
    },
    {
      "name": "cert pem name",
      "kind": "is_secret_name",
      "input": "MORPHEUS_NITRO_ROOT_CERT_PEM",
      "expected": false
    },
    {
      "name": "bare PK",
      "kind": "is_secret_name",
      "input": "PK",
      "expected": false
    },
    {
      "name": "unrelated env",
      "kind": "is_secret_name",
      "input": "MORPHEUS_RELAYER_POLL_INTERVAL_MS",
      "expected": false
    },
    {
      "name": "empty name",
      "kind": "is_secret_name",
      "input": "",
      "expected": false
    }
  ]
}
