# === NeoOS Standard .gitignore ===

# Tool State (NEVER commit)
/.claude/
/.codegraph/
/.serena/
/.planning/
/.workbuddy/
/.omx/
/.worktrees/
/graphify-out/
/.vercel/
/.turbo/

# Build Outputs
/dist/
/coverage/
/.next/
/test-results/
*.neopkg
*.wasm

# Cargo build output (workspace target dir at repo root)
/target/
workers/neo-signer/target

# .NET
/bin/
/obj/
**/bin/
**/obj/
contracts/**/bin
contracts/**/obj
examples/contracts/n3/bin/
examples/contracts/n3/obj/

# Dependencies
/node_modules/
workers/phala-worker/node_modules
contracts/neox/node_modules

# Environment
.env
.env.*
.env.local
.env.*.local
.env.ci
!.env.example

# Secrets
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.gpg

# Editor/IDE
/.vscode/
/.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Build outputs
node_modules
.npmrc
npm-debug.log*
*.tsbuildinfo
**/next-env.d.ts
dist
contracts/build
examples/build
contracts/neox/artifacts
contracts/neox/cache
contracts-evm/cache
contracts-evm/build/forge-out
contracts-evm/build/*.bin

# Morpheus state
.morpheus-relayer-state.json
.morpheus-relayer-state*.json
deploy/phala/morpheus.env
deploy/phala/morpheus.testnet.env
deploy/phala/morpheus.mainnet.env
deploy/phala/morpheus.hub.env
deploy/nitro/morpheus.*.env
deploy/nitro/*.env

# Backups
private-backups/

# Reports
docs/reports/
docs/*_20??-??-??.md

# Deployments
examples/deployments/*.20??-??-??.json
examples/deployments/control-plane-smoke.*.latest.json
examples/deployments/*.latest.json

# Neo-contract compiler artifacts (generated at repo root)
/MorpheusOracle.nef
/MorpheusOracle.manifest.json

# Secrets directory
.secrets/

# Operations backups
.ops-backups/

# Automation logs
.automation-logs/

# Mimosa state
**/.mimosa/
contracts-evm/build/*.bin
.env*
supabase/.temp
