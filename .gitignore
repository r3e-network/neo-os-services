# === NeoOS Standard .gitignore ===
#
# Directory patterns are unanchored on purpose: tool state, dependencies and
# build output appear under apps/*, workers/* and packages/* as well as at the
# root. scripts/gitignore-protections.test.mjs checks representative secret and
# artifact paths against these rules, and that no tracked source is ignored.

# Tool State (NEVER commit)
.claude/
.serena/
.planning/
.workbuddy/
.omx/
.codex/
.opencode/
.worktrees/
graphify-out/
.vercel/
.turbo/
# .codegraph/ is not listed: the tracked .codegraph/.gitignore ignores its
# own contents, and a pattern here would also match that tracked file.

# Build Outputs
dist/
coverage/
.next/
test-results/
playwright-report/
*.neopkg
*.wasm
*.tsbuildinfo
**/next-env.d.ts

# Cargo build output (workspace target dir at repo root)
/target/
workers/neo-signer/target

# .NET build output, wherever a project lives. Rust binary targets use
# src/bin/, which must stay tracked.
**/bin/
**/obj/
!**/src/bin/

# Dependencies
node_modules/

# Environment: every dotenv variant and *.env file, except committed examples.
.env*
*.env
!.env.example
!.env.*.example
!*.example.env

# Secrets
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.gpg
.npmrc
.secrets/
# Public AWS Nitro Enclaves root certificate, pinned for attestation checks.
!apps/web/lib/attestation/aws-nitro-root.pem

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
npm-debug.log*
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Build outputs
contracts/build
examples/build
contracts/neox/artifacts
contracts/neox/cache
contracts-evm/cache
contracts-evm/build/forge-out
contracts-evm/build/*.bin

# Morpheus state
.morpheus-relayer-state.json
.morpheus-relayer-state*.json
deploy/phala/morpheus.env
deploy/phala/morpheus.testnet.env
deploy/phala/morpheus.mainnet.env
deploy/phala/morpheus.hub.env
deploy/nitro/morpheus.*.env
deploy/nitro/*.env

# Backups
private-backups/
.ops-backups/

# Reports
docs/reports/
docs/*_20??-??-??.md

# Deployments (the tracked *.latest.json files are curated evidence; new
# live-run outputs stay local)
examples/deployments/*.20??-??-??.json
examples/deployments/control-plane-smoke.*.latest.json
examples/deployments/*.latest.json

# Neo-contract compiler artifacts (generated at repo root)
/MorpheusOracle.nef
/MorpheusOracle.manifest.json

# Automation logs
.automation-logs/

# Mimosa state
**/.mimosa/

# Supabase CLI state
supabase/.temp
